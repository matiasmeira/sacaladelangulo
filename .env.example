# =============================================================================
# Plantilla de variables de entorno de sacaladelangulo.
# Copiar a .env para desarrollo local (el .env real está gitignoreado).
# En producción, cargar estas variables en el panel de la plataforma
# (Railway/Render/Fly), NO en un archivo.
#
# LEYENDA:
#   [REQUERIDA]      la app NO arranca sin esto (fail-fast).
#   [REQUERIDA-PROD] tiene default apto para dev, pero DEBE setearse en prod.
#   [OPCIONAL]       tiene un default razonable; setear solo para cambiarlo.
# =============================================================================

# Perfil activo. En prod: "prod" (el Dockerfile ya lo trae por default).
# En dev local: "dev".
SPRING_PROFILES_ACTIVE=dev

# --- Base de datos -----------------------------------------------------------
# [REQUERIDA-PROD] host/nombre. En el perfil prod NO tienen default: si faltan,
# la app no arranca. En dev caen a localhost/sacaladelangulo.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sacaladelangulo
# [REQUERIDA-PROD] usuario (default dev: postgres).
DB_USERNAME=postgres
# [REQUERIDA] contraseña de la DB. Sin default en ningún perfil.
DB_PASSWORD=

# [OPCIONAL] modo SSL hacia la DB (solo perfil prod). Default: require.
# DB_SSLMODE=require
# [OPCIONAL] tamaño del pool HikariCP (solo perfil prod). Defaults: 5 / 1.
# DB_POOL_MAX_SIZE=5
# DB_POOL_MIN_IDLE=1
# [OPCIONAL] reintentos de conexión de Flyway al arrancar (perfil prod). Default 10.
# FLYWAY_CONNECT_RETRIES=10

# Alternativa a DB_HOST/PORT/NAME: una sola JDBC URL completa (mayor precedencia).
# Útil en plataformas que dan una única connection string. Incluir ?sslmode=require.
# SPRING_DATASOURCE_URL=jdbc:postgresql://host:5432/dbname?sslmode=require

# --- JWT ---------------------------------------------------------------------
# [REQUERIDA] secreto de firma HS256. MÍNIMO 32 bytes (256 bits) o la app no
# arranca. Generar uno aleatorio y único por entorno, ej:
#   openssl rand -base64 48
JWT_SECRET=
# [OPCIONAL] vida del token normal (ms). Default 3600000 (1 h).
# JWT_EXPIRATION_MILLIS=3600000
# [OPCIONAL] vida de la sesión de empleado de mostrador (ms). Default 900000 (15 min).
# JWT_EMPLEADO_EXPIRATION_MILLIS=900000

# --- Dispositivo de caja -----------------------------------------------------
# [OPCIONAL] vida del token de dispositivo emparejado (ms). Default 7776000000 (90 días).
# CAJA_DISPOSITIVO_EXPIRATION_MILLIS=7776000000
# [OPCIONAL] TTL del código de emparejamiento de un solo uso (ms). Default 600000 (10 min).
# CAJA_CODIGO_TTL_MILLIS=600000

# --- Frontend / CORS ---------------------------------------------------------
# [REQUERIDA-PROD] URL base del frontend, usada para armar links en los mails y
# el emparejamiento de caja. Default dev: http://localhost:5173. En prod: https://saque.ar
FRONTEND_URL=http://localhost:5173
# [REQUERIDA-PROD] orígenes permitidos por CORS (coma-separados). Default dev:
# http://localhost:5173,http://localhost:3000. En prod: https://saque.ar (y www si aplica).
# NUNCA usar "*" (la app envía credenciales/cookies; * + credenciales es inválido).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Email (Resend) ----------------------------------------------------------
# [REQUERIDA-PROD] activa el envío real (ResendEmailService). Default false ->
# LogEmailService (solo simula/loguea el envío). En prod: true.
RESEND_ENABLED=false
# [OPCIONAL] API key de Resend. Requerida si RESEND_ENABLED=true. Sin ella el
# envío real no funciona (con RESEND_ENABLED=false, se ignora).
# RESEND_API_KEY=
# [OPCIONAL] secreto para verificar la firma del webhook de Resend (bounces, etc.).
# Sin él, el endpoint de webhook queda cerrado. Formato: whsec_...
# RESEND_WEBHOOK_SECRET=
# [REQUERIDA-PROD] remitente de los mails transaccionales. Default: sandbox de
# Resend (onboarding@resend.dev). En prod: un dominio propio verificado en Resend.
# MAIL_FROM=SacaLaDelAngulo <no-reply@saque.ar>
# [OPCIONAL] remitente de los mails de marketing. Default: el mismo que MAIL_FROM.
# MARKETING_MAIL_FROM=SacaLaDelAngulo <ofertas@saque.ar>
